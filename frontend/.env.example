# Copy this file to ".env" in the frontend folder (frontend/.env).
# After changing this file, stop the frontend (Ctrl + C) and run "npm run dev" again.

VITE_API=http://localhost:4001/api/v1

# Google sign-in (optional). Firebase console > Project settings > Your apps > Web app.
# Leave these empty and the "Continue with Google" button stays hidden.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
