# ---------------------------------------------------------------------------
# EriWork website settings.
# Copy this file to ".env" in this same folder (frontend/.env).
# Vite reads these when it STARTS or BUILDS: after a change, restart
# "npm run dev" locally, or redeploy the Static Site on Render.
# ---------------------------------------------------------------------------

# Address of the API, ending in /api/v1.
# Locally:   http://localhost:4001/api/v1
# On Render: https://<your-api-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:4001/api/v1

# Google / Facebook sign-in (optional).
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# Leave these empty and the social sign-in buttons stay hidden.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
