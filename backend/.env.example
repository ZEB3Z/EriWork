# ---------------------------------------------------------------------------
# EriWork API settings.
# Copy this file to ".env" in this same folder (backend/.env) and fill it in.
# .env is gitignored, so your secrets never reach GitHub.
# On Render you type these into the service's "Environment" tab instead.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Render sets PORT for you. Locally the API runs on this port.
PORT=4001
# "development" locally, "production" on Render (turns on secure cross-site cookies).
NODE_ENV=development

# --- Database (MongoDB Atlas) ---------------------------------------------
# Atlas > Database > Connect > Drivers. Put the database name (eriwork) before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eriwork?retryWrites=true&w=majority

# --- Login sessions (JWT in an httpOnly cookie) ---------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
# How long a login lasts, e.g. 7d, 12h.
JWT_EXPIRE=7d
# Cookie lifetime in DAYS (keep it the same as JWT_EXPIRE).
COOKIE_EXPIRE=7

# --- Website address (CORS + password-reset links) -------------------------
# Locally: http://localhost:5173
# On Render: your Static Site URL, e.g. https://eriwork-web.onrender.com (no trailing slash).
# Several origins can be listed with commas.
FRONTEND_URL=http://localhost:5173

# --- Image storage (Cloudinary) --------------------------------------------
# Cloudinary console > Dashboard ("Product environment credentials").
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Nodemailer over SMTP via Mailtrap) -----------------------------
# Mailtrap > Email Testing (Sandboxes) > your inbox > Integration > SMTP.
# Keep port 2525: Render's free tier blocks outbound SMTP on 25, 465 and 587.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
# Sender shown in emails. Either "Name <address>" or just an address.
SMTP_FROM=EriWork <noreply@eriwork.local>

# --- Google / Facebook sign-in (optional, Firebase Authentication) ---------
# Only the project ID is needed: the server just verifies the ID token that
# Firebase gives the browser, so no service-account key file is required.
# Leave empty to turn social sign-in off on the server.
FIREBASE_PROJECT_ID=
