# Copy this file to ".env" in this same folder (backend/config/.env).

PORT=4001
NODE_ENV=DEVELOPMENT

# Local MongoDB. The database "eriwork" is created automatically.
DB_URI=mongodb://localhost:27017/eriwork

# Any long random string. Used to sign login tokens.
JWT_SECRET=change_this_to_any_long_random_string
JWT_EXPIRES_TIME=7d

# Where the website runs (used in password-reset links).
FRONTEND_URL=http://localhost:5173

# Email — order confirmations, status updates (with PDF receipt) and password resets.
# Mailtrap: Email Testing > Inboxes > your inbox > SMTP Settings.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=noreply@eriwork.local
SMTP_FROM_NAME=EriWork

# Google sign-in (optional). Your Firebase project ID, e.g. eriwork-12345.
# Leave empty to turn Google sign-in off.
FIREBASE_PROJECT_ID=
